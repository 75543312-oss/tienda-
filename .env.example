# Copia este archivo como .env y coloca tu cadena de conexión.
# El archivo .env está en .gitignore y NO se sube a GitHub.

# Opción 1: MongoDB local
MONGODB_URI=mongodb://127.0.0.1:27017/tienda_computadoras

# Opción 2: MongoDB Atlas (reemplaza usuario, contraseña y cluster)
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/tienda_computadoras

PORT=3000
